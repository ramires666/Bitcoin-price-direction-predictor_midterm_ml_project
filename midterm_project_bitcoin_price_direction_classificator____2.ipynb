    "    \"  \\\"kernelspec\\\": {\\n\",\n",
    "    \"   \\\"display_name\\\": \\\"Python 3\\\",\\n\",\n",
    "    \"   \\\"language\\\": \\\"python\\\",\\n\",\n",
    "    \"   \\\"name\\\": \\\"python3\\\"\\n\",\n",
