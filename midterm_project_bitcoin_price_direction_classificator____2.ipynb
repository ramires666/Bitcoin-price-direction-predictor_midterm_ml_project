    "\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"## 4. XGBoost Classifier Development\\n\",\n",
    "    \"\\n\",\n",
    "    \"We will now build the main prediction model.\\n\",\n",
    "    \"\\n\",\n",
    "    \"### 4.1 Feature Engineering\\n\",\n",
    "    \"We will add a rich set of features:\\n\",\n",
    "    \"*   **Volume:** Delta (Ask - Bid), Cumulative Delta, Moving Averages of Volume.\\n\",\n",
    "    \"*   **Momentum:** RSI, MACD, EMA trends.\\n\",\n",
    "    \"*   **Volatility:** Bollinger Bands (Width, %B).\\n\",\n",
    "    \"*   **HMM Features:** The state probabilities we generated in the previous step.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"def add_features(df):\\n\",\n",
    "    \"    df = df.copy()\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # --- Volume Features ---\\n\",\n",
    "    \"    df[\\\"volume_delta\\\"] = df[\\\"ask_vol\\\"] - df[\\\"bid_vol\\\"]\\n\",\n",
    "    \"    for window in [4, 12, 24, 96]:\\n\",\n",
    "    \"        df[f\\\"vol_delta_rolling_{window}\\\"] = df[\\\"volume_delta\\\"].rolling(window).sum()\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # --- Momentum Features ---\\n\",\n",
    "    \"    df.ta.rsi(length=14, append=True)\\n\",\n",
    "    \"    df.ta.macd(fast=12, slow=26, signal=9, append=True)\\n\",\n",
    "    \"    df['ema_12'] = ta.ema(df['close'], length=12)\\n\",\n",
    "    \"    df['ema_26'] = ta.ema(df['close'], length=26)\\n\",\n",
    "    \"    df['trend_ema'] = np.where(df['ema_12'] > df['ema_26'], 1, -1)\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    # --- Volatility Features ---\\n\",\n",
    "    \"    df.ta.bbands(length=20, std=2, append=True)\\n\",\n",
    "    \"    df['bb_width'] = (df['BBU_20_2.0'] - df['BBL_20_2.0']) / df['BBM_20_2.0']\\n\",\n",
    "    \"    \\n\",\n",
    "    \"    return df\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Apply Feature Engineering\\n\",\n",
    "    \"df_full = add_features(df_hmm)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Define Feature Columns (Exclude Target and Future Data)\\n\",\n",
    "    \"feature_cols = [\\n\",\n",
    "    \"    'volume_delta', 'vol_delta_rolling_4', 'vol_delta_rolling_12', 'vol_delta_rolling_24', 'vol_delta_rolling_96',\\n\",\n",
    "    \"    'RSI_14', 'MACD_12_26_9', 'MACDh_12_26_9', 'MACDs_12_26_9', 'trend_ema',\\n\",\n",
    "    \"    'bb_width', 'BBP_20_2.0',\\n\",\n",
    "    \"    'hmm_prob_0', 'hmm_prob_1', 'hmm_prob_2' # HMM Features\\n\",\n",
    "    \"]\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Shift features by 1 to prevent look-ahead bias (predicting NEXT bar using CURRENT features)\\n\",\n",
    "    \"df_full[feature_cols] = df_full[feature_cols].shift(1)\\n\",\n",
    "    \"df_full = df_full.dropna()\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"Features: {len(feature_cols)}\\\")\\n\",\n",
    "    \"print(feature_cols)\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"metadata\": {},\n",
    "   \"source\": [\n",
    "    \"### 4.2 Grid Search & Training\\n\",\n",
    "    \"We will use `RandomizedSearchCV` (a more efficient version of Grid Search) to find optimal hyperparameters for XGBoost.\\n\",\n",
    "    \"We will perform 200 iterations.\"\n",
    "   ]\n",
    "  },\n",
    "  {\n",
    "   \"cell_type\": \"code\",\n",
    "   \"execution_count\": null,\n",
    "   \"metadata\": {},\n",
    "   \"outputs\": [],\n",
    "   \"source\": [\n",
    "    \"# Prepare X and y\\n\",\n",
    "    \"X = df_full[feature_cols]\\n\",\n",
    "    \"y = df_full['target']\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Split Data (Time Series Split)\\n\",\n",
    "    \"train_size = int(len(X) * 0.7)\\n\",\n",
    "    \"val_size = int(len(X) * 0.15)\\n\",\n",
    "    \"\\n\",\n",
    "    \"X_train = X.iloc[:train_size]\\n\",\n",
    "    \"y_train = y.iloc[:train_size]\\n\",\n",
    "    \"\\n\",\n",
    "    \"X_val = X.iloc[train_size:train_size+val_size]\\n\",\n",
    "    \"y_val = y.iloc[train_size:train_size+val_size]\\n\",\n",
    "    \"\\n\",\n",
    "    \"X_test = X.iloc[train_size+val_size:]\\n\",\n",
    "    \"y_test = y.iloc[train_size+val_size:]\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Scale Features\\n\",\n",
    "    \"scaler = RobustScaler()\\n\",\n",
    "    \"X_train_scaled = scaler.fit_transform(X_train)\\n\",\n",
    "    \"X_val_scaled = scaler.transform(X_val)\\n\",\n",
    "    \"X_test_scaled = scaler.transform(X_test)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Define Hyperparameter Grid\\n\",\n",
    "    \"param_dist = {\\n\",\n",
    "    \"    'n_estimators': [100, 200, 300, 500],\\n\",\n",
    "    \"    'learning_rate': [0.01, 0.05, 0.1, 0.2],\\n\",\n",
    "    \"    'max_depth': [3, 5, 7, 9],\\n\",\n",
    "    \"    'min_child_weight': [1, 3, 5],\\n\",\n",
    "    \"    'subsample': [0.6, 0.8, 1.0],\\n\",\n",
    "    \"    'colsample_bytree': [0.6, 0.8, 1.0],\\n\",\n",
    "    \"    'gamma': [0, 0.1, 0.5]\\n\",\n",
    "    \"}\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Initialize XGBoost\\n\",\n",
    "    \"xgb = XGBClassifier(\\n\",\n",
    "    \"    objective='multi:softprob', \\n\",\n",
    "    \"    num_class=3, \\n\",\n",
    "    \"    eval_metric='mlogloss',\\n\",\n",
