    "    \"    \\\"scaler_hmm = RobustScaler()\\\\n\\\",\\n\",\n",
    "    \"    \\\"X_hmm_scaled = scaler_hmm.fit_transform(X_hmm)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Split for Training (Use first 70% to fit HMM)\\\\n\\\",\\n\",\n",
    "    \"    \\\"train_size = int(len(X_hmm_scaled) * 0.7)\\\\n\\\",\\n\",\n",
    "    \"    \\\"X_train_hmm = X_hmm_scaled[:train_size]\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Train Gaussian HMM\\\\n\\\",\\n\",\n",
    "    \"    \\\"print(\\\\\\\"Training HMM...\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"model_hmm = GaussianHMM(n_components=3, covariance_type=\\\\\\\"full\\\\\\\", n_iter=100, random_state=42)\\\\n\\\",\\n\",\n",
    "    \"    \\\"model_hmm.fit(X_train_hmm)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Predict States for ALL data\\\\n\\\",\\n\",\n",
    "    \"    \\\"hidden_states = model_hmm.predict(X_hmm_scaled)\\\\n\\\",\\n\",\n",
    "    \"    \\\"state_probs = model_hmm.predict_proba(X_hmm_scaled)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Add to DataFrame\\\\n\\\",\\n\",\n",
    "    \"    \\\"df_hmm['hmm_state'] = hidden_states\\\\n\\\",\\n\",\n",
    "    \"    \\\"for i in range(3):\\\\n\\\",\\n\",\n",
    "    \"    \\\"    df_hmm[f'hmm_prob_{i}'] = state_probs[:, i]\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"print(\\\\\\\"HMM Training Complete.\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"print(\\\\\\\"State Distribution:\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"print(df_hmm['hmm_state'].value_counts(normalize=True))\\\\n\\\",\\n\",\n",
