    "    \"    \\\"   \\\\\\\"execution_count\\\\\\\": null,\\\\n\\\",\\n\",\n",
    "    \"    \\\"   \\\\\\\"metadata\\\\\\\": {},\\\\n\\\",\\n\",\n",
    "    \"    \\\"   \\\\\\\"outputs\\\\\\\": [],\\\\n\\\",\\n\",\n",
    "    \"    \\\"   \\\\\\\"source\\\\\\\": [\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"# Calculate Log Returns\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"df['log_return'] = np.log(df['close'] / df['close'].shift(1))\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"df = df.dropna()\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"def check_stationarity(series, name=\\\\\\\\\\\\\\\"Series\\\\\\\\\\\\\\\"):\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    result = adfuller(series)\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    print(f\\\\\\\\\\\\\\\"--- ADF Test for {name} ---\\\\\\\\\\\\\\\")\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    print(f\\\\\\\\\\\\\\\"ADF Statistic: {result[0]:.4f}\\\\\\\\\\\\\\\")\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    print(f\\\\\\\\\\\\\\\"p-value: {result[1]:.4f}\\\\\\\\\\\\\\\")\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    print(\\\\\\\\\\\\\\\"Critical Values:\\\\\\\\\\\\\\\")\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    for key, value in result[4].items():\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        print(f\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\t{key}: {value:.4f}\\\\\\\\\\\\\\\")\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    \\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    if result[1] < 0.05:\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        print(f\\\\\\\\\\\\\\\"Result: {name} is STATIONARY (Reject H0)\\\\\\\\\\\\\\\")\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    else:\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        print(f\\\\\\\\\\\\\\\"Result: {name} is NON-STATIONARY (Fail to reject H0)\\\\\\\\\\\\\\\")\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    print(\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\\n\\\\\\\\\\\\\\\")\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"# Check Close Price\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"check_stationarity(df['close'].iloc[:10000], \\\\\\\\\\\\\\\"Close Price\\\\\\\\\\\\\\\")\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"# Check Log Returns\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"check_stationarity(df['log_return'].iloc[:10000], \\\\\\\\\\\\\\\"Log Returns\\\\\\\\\\\\\\\")\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"# Visualization\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"fig, axes = plt.subplots(2, 1, figsize=(15, 8))\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"axes[0].plot(df['close'].iloc[:1000], label='Close Price')\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"axes[0].set_title('Bitcoin Close Price (Non-Stationary)')\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"axes[0].legend()\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"axes[1].plot(df['log_return'].iloc[:1000], label='Log Returns', color='orange')\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"axes[1].set_title('Bitcoin Log Returns (Stationary)')\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"axes[1].legend()\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"plt.tight_layout()\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"plt.show()\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"   ]\\\\n\\\",\\n\",\n",
    "    \"    \\\"  },\\\\n\\\",\\n\",\n",
    "    \"    \\\"  {\\\\n\\\",\\n\",\n",
    "    \"    \\\"   \\\\\\\"cell_type\\\\\\\": \\\\\\\"markdown\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"   \\\\\\\"metadata\\\\\\\": {},\\\\n\\\",\\n\",\n",
    "    \"    \\\"   \\\\\\\"source\\\\\\\": [\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"### 1.2 Why Regression Fails\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"We will now train a simple XGBoost Regressor to predict the *next bar's log-return* using a small subset of data. \\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"We expect the $R^2$ score to be close to zero (or negative), indicating that the model cannot predict the magnitude of price changes better than a simple mean baseline.\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"   ]\\\\n\\\",\\n\",\n",
    "    \"    \\\"  },\\\\n\\\",\\n\",\n",
    "    \"    \\\"  {\\\\n\\\",\\n\",\n",
    "    \"    \\\"   \\\\\\\"cell_type\\\\\\\": \\\\\\\"code\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"   \\\\\\\"execution_count\\\\\\\": null,\\\\n\\\",\\n\",\n",
    "    \"    \\\"   \\\\\\\"metadata\\\\\\\": {},\\\\n\\\",\\n\",\n",
    "    \"    \\\"   \\\\\\\"outputs\\\\\\\": [],\\\\n\\\",\\n\",\n",
    "    \"    \\\"   \\\\\\\"source\\\\\\\": [\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"# Prepare data for regression demo (Subset)\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"subset_size = 5000\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"df_reg = df.iloc[:subset_size].copy()\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"# Features: Lagged returns\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"for i in range(1, 6):\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    df_reg[f'lag_{i}'] = df_reg['log_return'].shift(i)\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"df_reg = df_reg.dropna()\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"X_reg = df_reg[[f'lag_{i}' for i in range(1, 6)]]\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"y_reg = df_reg['log_return'] # Predict next return\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"# Split\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"X_train_reg, X_test_reg, y_train_reg, y_test_reg = train_test_split(X_reg, y_reg, test_size=0.2, shuffle=False)\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"# Train Simple XGBoost Regressor\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"regressor = XGBRegressor(n_estimators=100, max_depth=3, learning_rate=0.1, random_state=42)\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"regressor.fit(X_train_reg, y_train_reg)\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"# Predict\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"y_pred_reg = regressor.predict(X_test_reg)\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"# Evaluate\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"mse = mean_squared_error(y_test_reg, y_pred_reg)\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"r2 = r2_score(y_test_reg, y_pred_reg)\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"print(f\\\\\\\\\\\\\\\"Regression MSE: {mse:.8f}\\\\\\\\\\\\\\\")\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"print(f\\\\\\\\\\\\\\\"Regression R^2: {r2:.4f} (Expected to be near 0)\\\\\\\\\\\\\\\")\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"# Visualization\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"plt.figure(figsize=(15, 5))\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"plt.plot(y_test_reg.values[:200], label='Actual Returns', alpha=0.7)\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"plt.plot(y_pred_reg[:200], label='Predicted Returns', alpha=0.7)\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"plt.title('Regression: Actual vs Predicted Returns (First 200 Test Samples)')\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"plt.legend()\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"plt.show()\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"   ]\\\\n\\\",\\n\",\n",
    "    \"    \\\"  },\\\\n\\\",\\n\",\n",
    "    \"    \\\"  {\\\\n\\\",\\n\",\n",
    "    \"    \\\"   \\\\\\\"cell_type\\\\\\\": \\\\\\\"markdown\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"   \\\\\\\"metadata\\\\\\\": {},\\\\n\\\",\\n\",\n",
    "    \"    \\\"   \\\\\\\"source\\\\\\\": [\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"## 2. Target Generation: The \\\\\\\\\\\\\\\"Oracle\\\\\\\\\\\\\\\" Labeling\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"Since regression is difficult, we switch to **Classification** (Up/Down/Sideways).\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"To create high-quality labels, we use a **Centered Moving Average (Gaussian Smoothing)** on the *entire* dataset. \\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"**Why?** \\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"This creates a smooth trend line that uses future data (zero lag). This is valid for *target generation* because we want to teach the model what *actually happened*. We must ensure we **never** use this smoothed line as a feature.\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"**Classes:**\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"*   **2 (UP):** Slope > Threshold\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"*   **0 (DOWN):** Slope < -Threshold\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"*   **1 (SIDEWAYS):** |Slope| <= Threshold\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"   ]\\\\n\\\",\\n\",\n",
    "    \"    \\\"  },\\\\n\\\",\\n\",\n",
    "    \"    \\\"  {\\\\n\\\",\\n\",\n",
    "    \"    \\\"   \\\\\\\"cell_type\\\\\\\": \\\\\\\"code\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"   \\\\\\\"execution_count\\\\\\\": null,\\\\n\\\",\\n\",\n",
    "    \"    \\\"   \\\\\\\"metadata\\\\\\\": {},\\\\n\\\",\\n\",\n",
    "    \"    \\\"   \\\\\\\"outputs\\\\\\\": [],\\\\n\\\",\\n\",\n",
    "    \"    \\\"   \\\\\\\"source\\\\\\\": [\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"def create_target_labels(df, sigma=1, threshold=0.0005):\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    \\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\"\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    Creates target labels using Gaussian smoothing (Centered MA).\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    sigma: Controls smoothness (higher = smoother trend)\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    threshold: Slope threshold for Up/Down classification\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    \\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\"\\\\\\\\\\\\\\\"\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    df_target = df.copy()\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    \\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    # 1. Apply Gaussian Filter (Centered Smoothing)\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    # This uses the entire series (future and past) to smooth\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    df_target['smoothed_close'] = gaussian_filter1d(df_target['close'], sigma=sigma)\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    \\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    # 2. Calculate Slope (Derivative) of the smoothed line\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    # We use log returns of the smoothed line to be scale-invariant\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    df_target['smooth_slope'] = np.diff(np.log(df_target['smoothed_close']), prepend=np.nan)\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    \\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    # 3. Define Classes\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    conditions = [\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        df_target['smooth_slope'] > threshold,\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        df_target['smooth_slope'] < -threshold\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    ]\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    choices = [2, 0] # 2=UP, 0=DOWN\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    df_target['target'] = np.select(conditions, choices, default=1) # 1=SIDEWAYS\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    \\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    return df_target\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"# Apply Target Generation\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"# Adjust sigma and threshold to get a balanced distribution\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"SIGMA = 4  # Smoothing factor\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"THRESHOLD = 0.0002 # Slope threshold\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"df_labeled = create_target_labels(df, sigma=SIGMA, threshold=THRESHOLD)\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"print(\\\\\\\\\\\\\\\"Class Distribution:\\\\\\\\\\\\\\\")\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"print(df_labeled['target'].value_counts(normalize=True))\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"# Visualization of Labels\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"def plot_labels(df, start_idx, end_idx):\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    subset = df.iloc[start_idx:end_idx]\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    plt.figure(figsize=(15, 7))\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    \\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    # Plot Close Price\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    plt.plot(subset.index, subset['close'], label='Close Price', color='black', alpha=0.6)\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    \\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    # Plot Smoothed Target Line\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    plt.plot(subset.index, subset['smoothed_close'], label='Smoothed Target (Oracle)', color='blue', linestyle='--', linewidth=2)\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    \\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    # Color background based on Target\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    # We iterate to fill regions (this is slow for large data, good for zoom)\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    y_min, y_max = subset['close'].min(), subset['close'].max()\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    \\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    for i in range(len(subset) - 1):\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        idx = subset.index[i]\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        next_idx = subset.index[i+1]\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        target = subset['target'].iloc[i]\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        \\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        color = 'gray'\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        if target == 2: color = 'green'\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        elif target == 0: color = 'red'\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        \\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"        plt.axvspan(i, i+1, color=color, alpha=0.2, lw=0)\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    plt.title(f'Target Labeling (Sigma={SIGMA}, Thresh={THRESHOLD})')\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    plt.legend()\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"    plt.show()\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"# Plot a zoomed-in section\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"plot_labels(df_labeled.reset_index(), 1000, 1200)\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"   ]\\\\n\\\",\\n\",\n",
    "    \"    \\\"  }\\\\n\\\",\\n\",\n",
    "    \"    \\\" ]\\\\n\\\"\\n\",\n",
    "    \"   ],\\n\",\n",
    "    \"   \\\"id\\\": \\\"4e13be25fef5a72c\\\"\\n\",\n",
    "    \"  }\\n\",\n",
    "    \" ],\\n\",\n",
