    "    \"  {\\n\",\n",
    "    \"   \\\"cell_type\\\": \\\"markdown\\\",\\n\",\n",
    "    \"   \\\"metadata\\\": {},\\n\",\n",
    "    \"   \\\"source\\\": [\\n\",\n",
    "    \"    \\\"## 3. HMM Integration: Modeling Market Regimes\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"We use **Hidden Markov Models (HMM)** to identify latent market states (e.g., Low Volatility, Bull Trend, Bear Trend).\\\\n\\\",\\n\",\n",
    "    \"    \\\"We will train a Gaussian HMM with 3 states.\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"**Features for HMM:**\\\\n\\\",\\n\",\n",
    "    \"    \\\"*   Log Returns (Price movement)\\\\n\\\",\\n\",\n",
    "    \"    \\\"*   Range (High - Low) / Close (Volatility)\\\\n\\\",\\n\",\n",
    "    \"    \\\"*   Volume (Market Activity)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"**Important:** We fit the HMM *only* on the training portion of the data to avoid data leakage, then predict states for the entire dataset.\\\"\\n\",\n",
    "    \"   ]\\n\",\n",
    "    \"  },\\n\",\n",
    "    \"  {\\n\",\n",
    "    \"   \\\"cell_type\\\": \\\"code\\\",\\n\",\n",
    "    \"   \\\"execution_count\\\": null,\\n\",\n",
    "    \"   \\\"metadata\\\": {},\\n\",\n",
    "    \"   \\\"outputs\\\": [],\\n\",\n",
    "    \"   \\\"source\\\": [\\n\",\n",
    "    \"    \\\"# Prepare Data for HMM\\\\n\\\",\\n\",\n",
    "    \"    \\\"df_hmm = df_labeled.copy()\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Feature Engineering for HMM\\\\n\\\",\\n\",\n",
    "    \"    \\\"df_hmm['log_return'] = np.log(df_hmm['close'] / df_hmm['close'].shift(1))\\\\n\\\",\\n\",\n",
    "    \"    \\\"df_hmm['range_volatility'] = (df_hmm['high'] - df_hmm['low']) / df_hmm['close']\\\\n\\\",\\n\",\n",
    "    \"    \\\"df_hmm['log_volume'] = np.log(df_hmm['volume'] + 1)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"df_hmm = df_hmm.dropna()\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Select features\\\\n\\\",\\n\",\n",
    "    \"    \\\"hmm_features = ['log_return', 'range_volatility', 'log_volume']\\\\n\\\",\\n\",\n",
    "    \"    \\\"X_hmm = df_hmm[hmm_features].values\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Scale features (RobustScaler is good for outliers)\\\\n\\\",\\n\",\n",
    "    \"    \\\"scaler_hmm = RobustScaler()\\\\n\\\",\\n\",\n",
    "    \"    \\\"X_hmm_scaled = scaler_hmm.fit_transform(X_hmm)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Split for Training (Use first 70% to fit HMM)\\\\n\\\",\\n\",\n",
    "    \"    \\\"train_size = int(len(X_hmm_scaled) * 0.7)\\\\n\\\",\\n\",\n",
    "    \"    \\\"X_train_hmm = X_hmm_scaled[:train_size]\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Train Gaussian HMM\\\\n\\\",\\n\",\n",
    "    \"    \\\"print(\\\\\\\"Training HMM...\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"model_hmm = GaussianHMM(n_components=3, covariance_type=\\\\\\\"full\\\\\\\", n_iter=100, random_state=42)\\\\n\\\",\\n\",\n",
    "    \"    \\\"model_hmm.fit(X_train_hmm)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Predict States for ALL data\\\\n\\\",\\n\",\n",
    "    \"    \\\"hidden_states = model_hmm.predict(X_hmm_scaled)\\\\n\\\",\\n\",\n",
    "    \"    \\\"state_probs = model_hmm.predict_proba(X_hmm_scaled)\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Add to DataFrame\\\\n\\\",\\n\",\n",
    "    \"    \\\"df_hmm['hmm_state'] = hidden_states\\\\n\\\",\\n\",\n",
    "    \"    \\\"for i in range(3):\\\\n\\\",\\n\",\n",
    "    \"    \\\"    df_hmm[f'hmm_prob_{i}'] = state_probs[:, i]\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"print(\\\\\\\"HMM Training Complete.\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"print(\\\\\\\"State Distribution:\\\\\\\")\\\\n\\\",\\n\",\n",
    "    \"    \\\"print(df_hmm['hmm_state'].value_counts(normalize=True))\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Visualization of HMM States\\\\n\\\",\\n\",\n",
    "    \"    \\\"def plot_hmm_states(df, start_idx, end_idx):\\\\n\\\",\\n\",\n",
    "    \"    \\\"    subset = df.iloc[start_idx:end_idx]\\\\n\\\",\\n\",\n",
    "    \"    \\\"    plt.figure(figsize=(15, 7))\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Plot Close Price\\\\n\\\",\\n\",\n",
    "    \"    \\\"    plt.plot(subset.index, subset['close'], color='black', alpha=0.6, label='Close Price')\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\n\\\",\\n\",\n",
    "    \"    \\\"    # Color background by HMM State\\\\n\\\",\\n\",\n",
    "    \"    \\\"    colors = ['red', 'green', 'blue']\\\\n\\\",\\n\",\n",
    "    \"    \\\"    for i in range(len(subset) - 1):\\\\n\\\",\\n\",\n",
    "    \"    \\\"        idx = subset.index[i]\\\\n\\\",\\n\",\n",
    "    \"    \\\"        state = subset['hmm_state'].iloc[i]\\\\n\\\",\\n\",\n",
    "    \"    \\\"        plt.axvspan(i, i+1, color=colors[state], alpha=0.2, lw=0)\\\\n\\\",\\n\",\n",
    "    \"    \\\"        \\\\n\\\",\\n\",\n",
    "    \"    \\\"    plt.title('HMM Market States (Red/Green/Blue)')\\\\n\\\",\\n\",\n",
    "    \"    \\\"    plt.legend()\\\\n\\\",\\n\",\n",
    "    \"    \\\"    plt.show()\\\\n\\\",\\n\",\n",
    "    \"    \\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"# Visualize a section\\\\n\\\",\\n\",\n",
    "    \"    \\\"plot_hmm_states(df_hmm.reset_index(), 1000, 1200)\\\"\\n\",\n",
    "    \"   ]\\n\",\n",
    "    \"  }\\n\",\n",
    "    \" ]\\n\",\n",
    "    \"    \\\"    \\\\\\\"# Plot a zoomed-in section\\\\\\\\n\\\\\\\",\\\\n\\\",\\n\",\n",
    "    \"    \\\"    \\\\\\\"plot_labels(df_labeled.reset_index(), 1000, 1200)\\\\\\\"\\\\n\\\",\\n\",\n",
    "    \"    \\\"   ]\\\\n\\\",\\n\",\n",
    "    \"    \\\"  }\\\\n\\\",\\n\",\n",
